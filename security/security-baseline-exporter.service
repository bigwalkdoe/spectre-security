[Unit]
Description=Security Baseline Prometheus Exporter
After=network.target

[Service]
Type=oneshot
# Replace with the account that owns the checkout before installing.
User=__DEPLOY_USER__
# %h expands to that account's home directory. Adjust if you cloned elsewhere.
WorkingDirectory=%h/dev/github/spectre-security
ExecStart=%h/dev/github/spectre-security/security/security-baseline-exporter.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
