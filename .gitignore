# Generated runtime artifacts
#
# These directories hold scan output, drift reports, SBOMs, and AIDE integrity
# databases produced on the host running the tooling. They describe that host's
# real topology - container names, port bindings, bind-mount sources, file
# manifests - so they are generated per-environment and never committed.
security/logs/
security/reports/
security/compliance-reports/
performance/reports/
maintenance/reports/

# AIDE integrity databases enumerate every file on the host
security/aide/*.db.gz
security/aide/*.db.new.gz
security/aide/aide.log
# Regenerated by security/check-file-integrity-local.sh
security/aide/aide.conf

# The real infrastructure baseline. Generated by security/update-baseline.sh.
# Commit current-infrastructure.example.json instead.
security/test-data/current-infrastructure.json
security/test-data/current-infrastructure.json.backup.*

# Backup files
*.bak
*.backup
*~

# OS/Editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.venvs/

# Node
node_modules/
npm-debug.log*

# Go
*.exe
*.test
*.out

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Secrets
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.local
.env.*.local

# IDE
.vscode/settings.json

# Logs
*.log
*.log.*
